# Application
APP_NAME=AI Red-Team Platform
APP_VERSION=0.1.0
DEBUG=true

# Database
# PostgreSQL connection string (asyncpg or psycopg driver)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://redteam_user:your_password@localhost:5432/ai_redteam

# AI Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Authentication
# Generate a secure random secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secure_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30